# Unix commands
alias c='clear'

# Alternate viewers
alias cat='bat'
alias ls='lsd -Al --date=relative --group-dirs=first --icon=always --icon-theme=fancy --sort=extension'

# Misc.
alias reload='exec fish'

# Git
alias d='git diff'
alias ga='git add'
alias gcm='git commit -m'
alias gco='git checkout'
alias m='git merge'
alias p='git push'
alias pp='git pull'
alias s='git status'
