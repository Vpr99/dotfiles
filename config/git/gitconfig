# Base git config. Identity is resolved per-directory via the includes below:
#   ~/code/work/*     -> gitconfig-work     (fill in your new-gig email/key)
#   ~/code/personal/* -> gitconfig-personal
[includeIf "gitdir:~/code/work/"]
  path = ~/.gitconfig-work
[includeIf "gitdir:~/code/personal/"]
  path = ~/.gitconfig-personal

[user]
  name = Eric Skram
	signingkey = /Users/ericskram/.ssh/git_signing.pub
	email = eric@skram.com

# Send all GitHub git traffic over HTTPS with the gh token (credential helper below).
# The 1Password SSH agent refuses headless processes (agents, background jobs).
# The username in the URL makes curl skip the ~/.netrc `x-access-token` entry, a
# read-only internal-auth PAT that Docker builds mount, and ask gh instead.
[url "https://Vpr99@github.com/"]
  insteadOf = https://github.com/
  insteadOf = git@github.com:
  insteadOf = ssh://git@github.com/

[push]
  autoSetupRemote = true
[rebase]
  autosquash = true

# Commit signing via 1Password's SSH agent (Touch ID per signature).
[gpg]
  format = ssh
[gpg "ssh"]
  allowedSignersFile = ~/.config/git/allowed_signers
[commit]
  gpgsign = true

[core]
  editor = zed --wait
  pager = delta --line-numbers --dark
[delta]
  side-by-side = true

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[alias]
  fixup = "!git log -n 50 --pretty=format:'%h %s' --no-merges | fzf | cut -c -7 | xargs -o git commit --fixup"
  ls = "log --pretty=format:\"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]\" --decorate"

[credential "https://github.com"]
	helper = 
	helper = "!f() { gh=/opt/homebrew/bin/gh; [ -x $gh ] || gh=/opt/local/bin/gh; $gh auth git-credential \"$@\"; }; f"
[credential "https://gist.github.com"]
	helper = 
	helper = "!f() { gh=/opt/homebrew/bin/gh; [ -x $gh ] || gh=/opt/local/bin/gh; $gh auth git-credential \"$@\"; }; f"
