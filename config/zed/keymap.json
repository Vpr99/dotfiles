[
  // cmd+opt+shift+c → copy relative path (works from editor and project panel)
  {
    "context": "Editor",
    "bindings": {
      "cmd-alt-shift-c": "workspace::CopyRelativePath",
      "cmd-alt-c": "workspace::CopyPath",
    },
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "cmd-alt-shift-c": "workspace::CopyRelativePath",
      "cmd-alt-c": "workspace::CopyPath",
    },
  },
  // cmd+\ → toggle left dock (override Editor-context pane::SplitRight default)
  {
    "context": "Editor",
    "bindings": {
      "cmd-\\": "workspace::ToggleLeftDock",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-\\": "workspace::ToggleLeftDock",
    },
  },
  // cmd+shift+c → toggle terminal (matches your VS Code override)
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-c": "terminal_panel::ToggleFocus",
    },
  },
  // cmd+1-9 → switch tabs (not splits, like VS Code)
  {
    "context": "Pane",
    "bindings": {
      "cmd-1": ["pane::ActivateItem", 0],
      "cmd-2": ["pane::ActivateItem", 1],
      "cmd-3": ["pane::ActivateItem", 2],
      "cmd-4": ["pane::ActivateItem", 3],
      "cmd-5": ["pane::ActivateItem", 4],
      "cmd-6": ["pane::ActivateItem", 5],
      "cmd-7": ["pane::ActivateItem", 6],
      "cmd-8": ["pane::ActivateItem", 7],
      "cmd-9": ["pane::ActivateItem", 8],
    },
  },
]
