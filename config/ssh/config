Include /Users/ericskram/.ssh/conductor_config

# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

# Route all SSH auth through the 1Password agent.
# Requires: 1Password app installed + Settings -> Developer -> "Use the SSH agent".
# Your SSH keys live in 1Password — there are no private keys on disk.
Host *
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# Vault sync to creosote (home server, 2020 MacBook Air). On-disk key, because the
# 1Password agent refuses headless processes (the launchd auto-commit job).
# creosote restricts this key to git-shell: it can push and pull, nothing else.
Host creosote-git
	HostName creosote.local
	IdentityFile ~/.ssh/creosote_git
	IdentitiesOnly yes
	IdentityAgent none
